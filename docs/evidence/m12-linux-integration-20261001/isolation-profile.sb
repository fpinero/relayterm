(version 1)
(deny default)
(allow process-fork)
(allow process-info*)
(allow process-exec (subpath (param "RUNTIME_ROOT")) (literal "/bin/sh") (literal "/bin/bash") (literal "/bin/zsh") (literal "/bin/cat") (literal "/bin/cp") (literal "/bin/mv") (literal "/bin/chmod") (literal "/bin/mkdir") (literal "/usr/bin/nc"))
(allow mach-lookup)
(allow sysctl-read)
(allow pseudo-tty)
(allow file-ioctl (subpath "/dev"))
(allow signal)
(allow file-read-metadata)
(allow file-read* (literal "/"))
(allow file-read* (subpath (param "RUNTIME_ROOT")) (subpath "/System") (subpath "/usr/lib") (subpath "/usr/share") (subpath "/Library/Apple") (subpath "/dev")
 (literal "/bin/sh") (literal "/bin/bash") (literal "/bin/zsh") (literal "/bin/cat") (literal "/bin/cp") (literal "/bin/mv") (literal "/bin/chmod") (literal "/bin/mkdir") (literal "/usr/bin/nc"))
(allow file-write* (subpath (param "RUNTIME_ROOT")) (subpath "/dev"))
(allow network* (local unix-socket) (remote unix-socket))
