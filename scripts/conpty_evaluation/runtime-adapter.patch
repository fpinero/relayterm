+// The pinned Microsoft runtime requests DA1 during startup. Respond only after
+// observing that query, without consuming, rewriting or dropping output bytes.
+#[derive(Default)]
+struct BootstrapQuery {
+    matched: usize,
+    inspected: usize,
+    done: bool,
+}
+
+impl BootstrapQuery {
+    fn inspect(&mut self, bytes: &[u8]) -> bool {
+        const QUERY: &[u8] = b"\x1b[c";
+        for byte in bytes {
+            if self.done || self.inspected == 4096 { return false; }
+            self.inspected += 1;
+            if *byte == QUERY[self.matched] {
+                self.matched += 1;
+                if self.matched == QUERY.len() {
+                    self.done = true;
+                    return true;
+                }
+            } else {
+                self.matched = usize::from(*byte == QUERY[0]);
+            }
+        }
+        false
+    }
+}
+
+struct EvaluationReader {
+    reader: FileDescriptor,
+    input: FileDescriptor,
+    bootstrap: BootstrapQuery,
+}
+
+impl std::io::Read for EvaluationReader {
+    fn read(&mut self, buffer: &mut [u8]) -> std::io::Result<usize> {
+        let amount = std::io::Read::read(&mut self.reader, buffer)?;
+        if self.bootstrap.inspect(&buffer[..amount]) {
+            // VT100 with advanced video attributes, no unsupported capabilities.
+            std::io::Write::write_all(&mut self.input, b"\x1b[?1;2c")?;
+        }
+        Ok(amount)
+    }
+}
+
+#[cfg(test)]
+mod evaluation_tests {
+    use super::BootstrapQuery;
+
+    #[test]
+    fn bootstrap_query_is_split_safe_bounded_and_answered_once() {
+        let data = b"prefix\x1b[c\x1b[?1004h";
+        for split in 0..=data.len() {
+            let mut query = BootstrapQuery::default();
+            let answers = usize::from(query.inspect(&data[..split]))
+                + usize::from(query.inspect(&data[split..]));
+            assert_eq!(answers, 1);
+            assert!(!query.inspect(b"\x1b[c"));
+        }
+        let mut query = BootstrapQuery::default();
+        assert!(!query.inspect(&vec![b'x'; 4096]));
+        assert!(!query.inspect(b"\x1b[c"));
+        let mut query = BootstrapQuery::default();
+        assert!(!query.inspect(b"\x1b[?1;2c"));
+        assert!(query.inspect(b"\x1b\x1b[c"));
+    }
+}
